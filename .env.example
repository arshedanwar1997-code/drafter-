# GEMINI_API_KEY: Optional server-side key (unused unless AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing admin session JWT tokens.
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# SQLITE_DB_PATH: Optional custom path for SQLite database file.
SQLITE_DB_PATH="data/trademark_advisory.db"

# INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD: Used by scripts/setup-admin.mjs or initial seed.
INITIAL_ADMIN_EMAIL="admin@legalsuccessindia.in"
INITIAL_ADMIN_PASSWORD="LegalSuccess@2026"
